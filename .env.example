# 本地配置：复制成 .env 再改（.env 已被 .gitignore 忽略，不会被提交）

# ============ 基本 ============
# 城市，直接写中文（Open-Meteo 自动做地理编码）
CITY=北京

# 推送渠道，逗号分隔，可多选：
#   wechat_mp   微信公众号模板消息
#   mail        邮件
#   serverchan  Server酱
#   pushplus    PushPlus
#   wecom       企业微信群机器人
PUSH_CHANNELS=wechat_mp

# ============ 微信公众号（模板消息）============
# 从「接口测试号」或「认证服务号」后台拿：设置与开发 → 基本配置
WX_APPID=
WX_APPSECRET=
# 模板消息里的模板 ID
WX_TEMPLATE_ID=
# 收件人的 openid，多个用逗号分隔
WX_OPENID=

# 可选：模板里要填哪些字段（默认 title,weather,news,tip,remark；配了 LLM 会多一个 ai）
# WX_FIELDS=title,weather,news,tip,remark
# 可选：点开消息时跳转的链接
# WX_LINK_URL=https://mp.weixin.qq.com/
# 可选：走代理域名（国内机器一般不用改）
# WX_API_BASE=https://api.weixin.qq.com

# ============ 邮件 ============
# QQ 邮箱：设置 → 账号 → 开启 SMTP → 生成「授权码」，把授权码填进 SMTP_PASS
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=you@qq.com
# SMTP_PASS=你的授权码
# MAIL_TO=you@qq.com

# ============ 其他渠道（可选）============
# SERVERCHAN_SENDKEY=
# PUSHPLUS_TOKEN=
# WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# ============ AI 一句话（可选）============
# 任何 OpenAI 兼容接口都行，默认按 DeepSeek 填
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# ============ 内容微调（可选）============
# NEWS_SOURCES=ithome,ifanr,sspai,solidot,geekpark,tmtpost
# NEWS_COUNT=6
# NEWS_LOOKBACK_HOURS=30
# EXTRAS=quote,countdown,fx
# COUNTDOWN=2027-01-01|元旦,2026-12-25|圣诞
# FX_PAIRS=USD:CNY,EUR:CNY
